{
  "name": "video-repair",
  "version": "1.2.0",
  "description": "Local advanced repair for corrupted MP4 and MOV files. Runs on macOS and Windows.",
  "license": "MIT",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "open": "node scripts/launch.js",
    "stop": "node scripts/launch.js --stop",
    "check": "node scripts/launch.js --check",
    "dev": "node server/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
