  "os": [
    "darwin",
    "win32",
    "linux"
  ],
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^11.1.0"
  }
